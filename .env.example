# Modelo de configuração. Os valores reais (hosts, usuários e senhas) ficam
# no .env de cada ambiente, que NÃO é versionado — peça ao time de Dados.

# ---------------------------------------------------------------------------
# Voalle (PostgreSQL) — no Power BI era o DSN "dbVoalle"
# ---------------------------------------------------------------------------
DB_VOALLE_HOST=ip-do-voalle
DB_VOALLE_DATABASE=nome-do-banco
DB_VOALLE_USER=usuario-voalle
DB_VOALLE_PASSWORD=troque-aqui
DB_VOALLE_PORT=5432

# ---------------------------------------------------------------------------
# MariaDB (equipes comerciais / RH Senior) — no Power BI era o DSN "dbMaria"
# ---------------------------------------------------------------------------
DB_MARIA_HOST=ip-do-mariadb
DB_MARIA_DATABASE=DB_Applicattion
DB_MARIA_USER=usuario-mariadb
# atenção: use aspas simples se a senha tiver # ou espaços
DB_MARIA_PASSWORD='troque-aqui'
DB_MARIA_PORT=3306

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
PORT=8080

# Recorte histórico (igual ao modelo do Power BI)
# semente do recorte histórico: vale enquanto ninguém definir
# a janela em Configurações -> Janela de dados (que grava em data/janela.json)
DATA_SINCE=2024-01-01
PHONE_SINCE=2024-11-01
# recorte do CRM (leads e negociações). No .pbip de Leads é a constante
# '2026-01-01' escrita dentro das duas consultas. As três datas são apenas a
# SEMENTE: quem manda é Configurações -> Janela de dados.
CRM_SINCE=2026-01-01

# Frequência de atualização (ms)
REFRESH_HOT_MS=120000       # janela incremental  (2 min)
REFRESH_FULL_MS=1800000     # recarga completa    (30 min)
REFRESH_DIMS_MS=900000      # equipes / RH        (15 min)
REFRESH_COND_MS=600000      # splitters de condomínio (10 min)
INCREMENTAL_DAYS=60         # janela das cargas incrementais

# ---------------------------------------------------------------------------
# Autenticação (login com Google) e acessos
# ---------------------------------------------------------------------------
# credenciais do projeto no Google Cloud (OAuth 2.0 · aplicativo web)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=troque-aqui

AUTH_ENABLED=true
ALLOWED_DOMAIN=sebratel.com.br
# semente de administradores (não pode ser removida pela tela)
ADMIN_EMAILS=nome@sebratel.com.br
# usuários DEV (power users) — veem o catálogo de queries
DEV_EMAILS=nome@sebratel.com.br
# onde ficam papéis e permissões por tela (no Docker use um volume)
ACCESS_PATH=./data/access.json

# ---------------------------------------------------------------------------
# Provedor de IA (opcional — pode ser cadastrado pela tela de Configurações)
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic        # anthropic | openai | gemini
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5
# AI_BASE_URL=                 # Groq, OpenRouter, Azure, servidor local…

# chave que cifra os segredos em repouso (openssl rand -base64 48)
# sem ela, uma é gerada no volume de dados
# SECRET_KEY=
